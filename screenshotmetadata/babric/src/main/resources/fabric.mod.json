{
  "schemaVersion": 1,
  "id": "screenshotmetadata",
  "version": "${version}",
  "name": "Screenshot Metadata",
  "description": "Automatically adds metadata to Minecraft Beta 1.7.3 screenshots, including player info, coordinates, world data and biome information. Metadata is stored as PNG text chunks, embedded XMP, and XMP/JSON sidecar files.",
  "authors": ["fentbuscoding"],
  "contact": {
    "homepage": "https://github.com/fentbuscoding/screenshot-metadata-mod",
    "sources": "https://github.com/fentbuscoding/screenshot-metadata-mod"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.fentbuscoding.screenshotmetadata.ScreenshotMetadataMod"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.0.0-beta.7.3",
    "java": ">=${java_version}"
  },
  "mixins": [
    "screenshotmetadata.mixins.json"
  ]
}
